# Copy this file to ".env" and edit the values. NEVER commit the real .env file.

NODE_ENV=development
PORT=3000

# Public URL of the site (used for the sitemap and robots.txt)
SITE_URL=http://localhost:3000

# Where enquiries are saved:
#   file      -> backend/storage/enquiries.json (local development, or a server with a persistent disk)
#   supabase  -> a Supabase/Postgres table (recommended on Vercel, whose disk is not persistent)
STORAGE_DRIVER=file

# Only needed when STORAGE_DRIVER=supabase. Keep the service key SECRET (server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=enquiries

# Optional: lets you read saved enquiries at GET /api/admin/enquiries
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Rate limiting (defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5

# Set to 1 when the app runs behind a proxy/load balancer (Vercel, Render, Nginx...)
TRUST_PROXY=0

# Public contact details shown on the site (leave blank to hide)
COMPANY_EMAIL=hello@learnsprint.ink
COMPANY_PHONE=
SOCIAL_LINKEDIN=
SOCIAL_GITHUB=
SOCIAL_X=
SOCIAL_FACEBOOK=
